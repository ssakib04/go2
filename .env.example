# Public client config. These values are safe to ship in the app binary.
# The anon key is the legacy JWT anon key. The publishable key is an equivalent
# client key if you prefer it: sb_publishable_1qi-YIW-428vqUFCWBht0w_oc9gPVvM

EXPO_PUBLIC_SUPABASE_URL=https://rsmxyisnwluqashngmht.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJzbXh5aXNud2x1cWFzaG5nbWh0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQyMjg5MjIsImV4cCI6MjEwOTgwNDkyMn0.xf6Oz2RxNMfbXl27Cjd3uaBg2U1LRoIUlLuNC3ma-_M

# Google OAuth client IDs from Google Cloud Console. See README.
# The Web client ID is also the audience of the ID token sent to Supabase,
# and the client that mints the host server auth code.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional. Set after `eas init` if you use EAS Update / a linked project.
EAS_PROJECT_ID=

# Edge Function secrets. Set these in the Supabase dashboard or CLI.
# Do not put them in the mobile app.
# GOOGLE_CLIENT_ID=<same Web client id as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<Web client secret>
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions by Supabase. Do not copy the service role key into the app.
